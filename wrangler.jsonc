{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paperpilot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-17",
  "assets": {
    "directory": "docs",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "LLM_BASE_URL": "https://api.deepseek.com",
    "LLM_MODEL": "deepseek-v4-flash"
  },
  "observability": {
    "enabled": true
  }
}
